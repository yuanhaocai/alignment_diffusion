{
  "name": "Wine revised PI: independent training/validation/calibration and unchanged test",
  "protocol_note": "Retrains train-only preprocessing and VAE, selects the variant on validation, then calibrates on separate cal. M=200, alpha=.05. See docs/wine_prediction_intervals.md.",
  "variables": {
    "data_root": "{repo}/data",
    "embedding_root": "{repo}/embeddings",
    "artifacts_root": "{repo}/artifacts",
    "source_dir": "{data_root}/wine_review3",
    "test_source_dir": "{source_dir}",
    "text_dir": "{embedding_root}/wine_review3_text_clip_embd",
    "run_root": "{artifacts_root}/wine_prediction_interval",
    "gpu": "0",
    "variant": "full"
  },
  "commands": [
    {
      "name": "prepare_interval_data",
      "cwd": "{repo}",
      "argv": [
        "{python}",
        "scripts/run_wine_pi.py",
        "--source-dir",
        "{source_dir}",
        "--test-source-dir",
        "{test_source_dir}",
        "--text-dir",
        "{text_dir}",
        "--run-dir",
        "{run_root}",
        "--gpu",
        "{gpu}",
        "--variant",
        "{variant}",
        "--stage",
        "prepare"
      ]
    },
    {
      "name": "train_interval_model",
      "cwd": "{repo}",
      "argv": [
        "{python}",
        "scripts/run_wine_pi.py",
        "--source-dir",
        "{source_dir}",
        "--test-source-dir",
        "{test_source_dir}",
        "--text-dir",
        "{text_dir}",
        "--run-dir",
        "{run_root}",
        "--gpu",
        "{gpu}",
        "--variant",
        "{variant}",
        "--stage",
        "train"
      ]
    },
    {
      "name": "sample_calibration_and_test",
      "cwd": "{repo}",
      "argv": [
        "{python}",
        "scripts/run_wine_pi.py",
        "--source-dir",
        "{source_dir}",
        "--test-source-dir",
        "{test_source_dir}",
        "--text-dir",
        "{text_dir}",
        "--run-dir",
        "{run_root}",
        "--gpu",
        "{gpu}",
        "--variant",
        "{variant}",
        "--stage",
        "sample"
      ]
    },
    {
      "name": "evaluate_interval",
      "cwd": "{repo}",
      "argv": [
        "{python}",
        "scripts/run_wine_pi.py",
        "--source-dir",
        "{source_dir}",
        "--test-source-dir",
        "{test_source_dir}",
        "--text-dir",
        "{text_dir}",
        "--run-dir",
        "{run_root}",
        "--gpu",
        "{gpu}",
        "--variant",
        "{variant}",
        "--stage",
        "evaluate"
      ]
    }
  ]
}
