{
  "name": "Petfinder aligned full workflow",
  "protocol_note": "The validation split is sampled and evaluated before the held-out test split.",
  "variables": {
    "data_root": "{repo}/data",
    "embedding_root": "{repo}/embeddings",
    "pretrained_root": "{repo}/pretrained",
    "artifacts_root": "{repo}/artifacts",
    "dataset": "petfinder_wval",
    "run_root": "{artifacts_root}/petfinder_full",
    "alignment_dir": "{run_root}/alignment",
    "aligned_embedding_dir": "{run_root}/aligned_embeddings",
    "diffusion_dir": "{run_root}/diffusion",
    "sampling_val_dir": "{run_root}/sampling_val_m50",
    "sampling_dir": "{run_root}/sampling_test_m50"
  },
  "commands": [
    {
      "name": "alignment_train",
      "cwd": "{repo}/src/alignment",
      "argv": [
        "{python}", "-m", "accelerate.commands.launch",
        "--num_processes", "1", "main.py",
        "--text_path", "{embedding_root}/{dataset}_text_clip_embd",
        "--train_z_dat_path", "{pretrained_root}/{dataset}/tabular_vae",
        "--y_path", "{data_root}/{dataset}",
        "--save_dir", "{alignment_dir}",
        "--batch_size", "128",
        "--emb_dim", "768",
        "--y_num_classes", "5",
        "--lr", "0.0003",
        "--n_epochs", "200",
        "--eval_interval", "1",
        "--weight_clip_loss", "0.1",
        "--weight_sup_loss", "1.0",
        "--projector_mode", "linear",
        "--patience", "150",
        "--y_type", "categorical"
      ]
    },
    {
      "name": "alignment_transform",
      "cwd": "{repo}",
      "argv": [
        "{python}", "scripts/transform_alignment.py",
        "--checkpoint", "{alignment_dir}/models/tabtext_align.pt",
        "--text-path", "{embedding_root}/{dataset}_text_clip_embd",
        "--tabular-path", "{pretrained_root}/{dataset}/tabular_vae",
        "--output-dir", "{aligned_embedding_dir}",
        "--y-type", "categorical",
        "--y-num-classes", "5",
        "--projector-mode", "linear",
        "--residual-scale", "1.0",
        "--tabular-normalization", "numpy-population",
        "--splits", "train", "val", "test"
      ]
    },
    {
      "name": "diffusion_train",
      "cwd": "{repo}",
      "argv": [
        "{python}", "scripts/pm_diff_train.py",
        "--y_emb_path", "{pretrained_root}/{dataset}/response_vae",
        "--emb_alignment_path", "{aligned_embedding_dir}",
        "--diffusion_path", "{diffusion_dir}",
        "--y_type", "categorical",
        "--use_tab", "true",
        "--use_text", "true",
        "--use_image", "false",
        "--d_in", "5",
        "--dim_t", "1024",
        "--cond_dim", "768",
        "--text_pooling", "mean",
        "--normalize_tab_cond", "true",
        "--normalize_text_tokens", "false",
        "--normalize_text_pooled", "true",
        "--normalize_projected_cond", "false",
        "--epochs", "5000",
        "--batch_size", "512",
        "--lr", "0.00004916734586122233",
        "--early_stopping_thrshd", "500",
        "--clip_grad", "true",
        "--clip_grad_max_norm", "2.0",
        "--use_wandb", "false"
      ]
    },
    {
      "name": "sample_validation",
      "cwd": "{repo}",
      "argv": [
        "{python}", "scripts/pm_diff_sample.py",
        "--data_path", "{data_root}/{dataset}",
        "--diffusion_path", "{diffusion_dir}",
        "--sampling_path", "{sampling_val_dir}",
        "--batch_size", "1024",
        "--steps", "50",
        "--num_repeats", "50",
        "--use_val", "true",
        "--seed", "42"
      ]
    },
    {
      "name": "evaluate_validation",
      "cwd": "{repo}",
      "argv": [
        "{python}", "scripts/pm_gen_check.py",
        "--data-path", "{data_root}/{dataset}",
        "--sampling-paths", "{sampling_val_dir}",
        "--pm-task", "cls",
        "--y-num-classes", "5",
        "--num-repeats", "50",
        "--use-val", "true"
      ]
    },
    {
      "name": "sample_test",
      "cwd": "{repo}",
      "argv": [
        "{python}", "scripts/pm_diff_sample.py",
        "--data_path", "{data_root}/{dataset}",
        "--diffusion_path", "{diffusion_dir}",
        "--sampling_path", "{sampling_dir}",
        "--batch_size", "1024",
        "--steps", "50",
        "--num_repeats", "50",
        "--seed", "42"
      ]
    },
    {
      "name": "evaluate_test",
      "cwd": "{repo}",
      "argv": [
        "{python}", "scripts/pm_gen_check.py",
        "--data-path", "{data_root}/{dataset}",
        "--sampling-paths", "{sampling_dir}",
        "--pm-task", "cls",
        "--y-num-classes", "5",
        "--num-repeats", "50"
      ]
    }
  ]
}
